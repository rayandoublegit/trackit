{
  "functions": {
    "src/app/api/analyze/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/seed-niches/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/enrich-creators/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/scrape/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/scrape/weekly-refresh/route.ts": {
